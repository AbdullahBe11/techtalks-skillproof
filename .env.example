DATABASE_URL=your_database_url_here
NEXTAUTH_SECRET=your_nextauth_secret_here
NEXTAUTH_URL=http://localhost:3000
# Public URL of the site, used in password-reset emails (required in production)
APP_URL=https://techtalks-skillproof.vercel.app

# SMTP for password-reset emails (e.g. Gmail with an App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_gmail_address@gmail.com
SMTP_PASS=your_16_character_app_password
EMAIL_FROM="SkillProof <your_gmail_address@gmail.com>"
