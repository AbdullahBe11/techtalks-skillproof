generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  candidate
  recruiter
  verifier
  admin
}

enum ProjectState {
  draft
  published
  archived
}

enum VerificationStatus {
  pending
  verified
  rejected
}

enum EvidenceType {
  github
  demo
  documentation
  other
}

model User {
  id          String    @id @default(uuid())
  name        String
  email       String    @unique
  role        Role      @default(candidate)
  password    String
  phoneNumber String?   @map("phone_number")
  createdAt   DateTime  @default(now()) @map("created_at")
  emailVerifiedAt DateTime? @map("email_verified_at")
  
  profile     Profile?
  reviews     Review[]
  interests   Interest[]
  shortLists  ShortList[]
  passwordResetTokens PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  verifiedProjects Project[] @relation("ProjectVerifier")
  
  @@map("users")
}

model Profile {
  id         String   @id @default(uuid())
  userId     String   @unique @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bio        String?
  cvUrl      String?  @map("cv_url")
  headline     String?
  githubUrl    String?  @map("github_url")
  linkedinUrl  String?  @map("linkedin_url")
  portfolioUrl String?  @map("portfolio_url")
  createdAt  DateTime @default(now()) @map("created_at")
  
  projects   Project[]
  interests  Interest[]
  shortLists ShortList[]
  
  @@map("profiles")
}

model Project {
  id              String         @id @default(uuid())
  profileId       String         @map("profile_id")
  profile         Profile        @relation(fields: [profileId], references: [id], onDelete: Cascade)
  title           String
  description     String?
  createdAt       DateTime       @default(now()) @map("created_at")
  publishedState  ProjectState   @default(draft) @map("published_state")
  verificationStatus VerificationStatus @default(pending) @map("verification_status")
  reviewerFeedback   String?            @map("reviewer_feedback")
  skills             String[]           @default([])
  
  evidence        Evidence[]
  reviews         Review[]
  verifiedById String?   @map("verified_by_id")
  verifiedAt   DateTime? @map("verified_at")
  verifiedBy   User?     @relation("ProjectVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)
  
  @@map("projects")
}

model Evidence {
  id          String      @id @default(uuid())
  projectId   String      @map("project_id")
  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type        EvidenceType
  evidenceUrl String      @map("evidence_url")
  createdAt   DateTime    @default(now()) @map("created_at")
  shortLabel  String      @default("") @map("short_label")
  
  @@map("evidence")
}

model RubricCriterion {
  id          String    @id @default(uuid())
  name        String
  description String?
  maxScore    Int       @map("max_score")
  
  scores      ReviewScore[]
  
  @@map("rubric_criteria")
}

model Review {
  id          String         @id @default(uuid())
  projectId   String         @map("project_id")
  project     Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId      String         @map("user_id")
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  verified    Boolean        @default(false)
  createdAt   DateTime       @default(now()) @map("created_at")
  isVisible   Boolean        @default(true) @map("is_visible")
  
  scores      ReviewScore[]
  
  @@unique([projectId, userId])
  @@map("reviews")
}

model ReviewScore {
  reviewId    String         @map("review_id")
  review      Review         @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  criterionId String         @map("criterion_id")
  criterion   RubricCriterion @relation(fields: [criterionId], references: [id], onDelete: Cascade)
  score       Int
  
  @@id([reviewId, criterionId])
  @@map("reviews_scores")
}

model Interest {
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  profileId  String   @map("profile_id")
  profile    Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now()) @map("created_at")
  
  @@id([userId, profileId])
  @@map("interests")
}

model ShortList {
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  profileId  String   @map("profile_id")
  profile    Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now()) @map("created_at")
  
  @@id([userId, profileId])
  @@map("short_lists")
}

// One-time tokens for "forgot password". Only a SHA-256 hash of the token is
// stored — the raw token only ever exists in the emailed link.
model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("password_reset_tokens")
}

// One-time tokens used to confirm a newly registered email address.
// Only the SHA-256 hash is stored in the database.
model EmailVerificationToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("email_verification_tokens")
}
